{
  "name": "fmlab-reel-kit",
  "version": "1.5.0",
  "private": true,
  "description": "FMLAB Reel Kit: reel explainer verticali da un argomento. Copione, voce, scene sincronizzate alle parole, mp4.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pannello": "node motore/cli.mjs pannello",
    "stato": "node motore/cli.mjs stato",
    "test": "node prove/motore.mjs && node prove/libreria.mjs && node prove/difetti.mjs",
    "prove:lente": "node prove/lente.mjs",
    "collaudo": "node motore/cli.mjs collaudo",
    "nuovo": "node motore/cli.mjs nuovo",
    "imposta": "node motore/cli.mjs imposta",
    "voce": "node motore/cli.mjs voce",
    "foto": "node motore/cli.mjs foto",
    "provini": "node motore/cli.mjs provini",
    "anteprima": "node motore/cli.mjs anteprima",
    "render": "node motore/cli.mjs render",
    "verifica": "node motore/cli.mjs verifica",
    "personaggio": "node motore/cli.mjs personaggio",
    "catalogo": "node motore/cli.mjs catalogo",
    "icone": "node motore/cli.mjs icone",
    "clip": "node motore/cli.mjs clip",
    "riuso": "node motore/cli.mjs riuso",
    "suoni": "node motore/cli.mjs suoni",
    "aiuto": "node motore/cli.mjs aiuto"
  },
  "dependencies": {
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "roughjs": "4.6.6"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
