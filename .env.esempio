# Copia questo file con il nome ".env" (senza "esempio") e riempi quello che ti serve.
# Il file .env resta sul tuo computer: non condividerlo.

# ── Voce ElevenLabs (la migliore, con sincronia esatta) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Facoltativi:
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.0
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_VOICE_ID_EN=          (una voce diversa per l'inglese; vale per ogni lingua: _ES, _FR…)

# La voce si può scegliere reel per reel dal pannello: quella scelta lì vince su ELEVENLABS_VOICE_ID.
# Se il testo non cambia, rigenerare la voce non consuma crediti (viene riusata).

# ── Un altro servizio di voce (motore "comando": vedi voci/COME-FARE.md) ──
# FMLAB_VOCE_COMANDO=node voci/modello.mjs {testo} {uscita} {lingua} {voce}
# MIA_VOCE_CHIAVE=

# ── Voce del Mac (gratuita, si usa quando non c'è la chiave ElevenLabs) ──
# FMLAB_VOCE_MAC=Alice
# FMLAB_VELOCITA_MAC=185

# ── Effetti sonori ([suono:pop] nel copione): volume di tutti, da 0 (spenti) a 100 ──
# FMLAB_VOLUME_SUONI=60

# ── Solo se il kit non li trova da solo ──
# FMLAB_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# FMLAB_FFMPEG=/percorso/di/ffmpeg

# ── Velocità del render: quanti pezzi fare in parallelo (di serie: metà dei processori, al massimo 4) ──
# FMLAB_LAVORATORI=3

# ── Pannello (npm run pannello) ──
# FMLAB_PORTA_PANNELLO=4180
# Per far partire l'agente dal pannello con un tocco: il comando con cui lo avvii dal Terminale.
# Il pannello gli passa in fondo la frase della richiesta (oppure mettila tu dove vuoi con {richiesta}).
# Con Codex:        FMLAB_AGENTE=codex exec --full-auto
# Con Claude Code:  FMLAB_AGENTE=claude -p --permission-mode acceptEdits --allowedTools "Bash,Read,Write,Edit"
# Con un altro:     FMLAB_AGENTE=nome-del-comando -p
# Da un altro dispositivo (telefono) l'agente parte solo con questa riga:
# FMLAB_AGENTE_RETE=si

# ── Immagini generate (materiale per le scene: soggetti su fondo trasparente; il video lo fa sempre il kit) ──
# Chi le genera. "nessuno" = solo la biblioteca libreria/immagini/: non genera e non spende mai.
# FMLAB_IMMAGINI=nessuno            (nessuno | higgsfield | stability | comando)
# Higgsfield: le due chiavi si creano su cloud.higgsfield.ai
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
# FMLAB_HIGGSFIELD_MODELLO=higgsfield-ai/soul/standard
# Stability:
# STABILITY_API_KEY=
# Un programma tuo che scrive un PNG (riceve il prompt e il file di uscita; anche {larghezza} e {altezza}):
# FMLAB_IMMAGINI_COMANDO="mio-programma {prompt} {uscita}"
